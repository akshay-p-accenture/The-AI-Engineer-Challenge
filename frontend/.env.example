# Base URL of the FastAPI backend. No trailing slash.
# Requests are sent to ${NEXT_PUBLIC_API_URL}/api/chat
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shown in the insights panel. Purely cosmetic — the backend picks the real model.
NEXT_PUBLIC_MODEL_NAME=gpt-5

# Product name shown in the sidebar and window title.
NEXT_PUBLIC_APP_NAME=Meridian
